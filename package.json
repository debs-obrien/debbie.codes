    "lint:fix": "eslint . --fix",
    "test": "playwright test",
    "test:endform": "endform test",
    "check:origin-trial": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-origin-trial.mjs",
    "check:cloudinary": "node scripts/check-no-cloudinary.mjs",
