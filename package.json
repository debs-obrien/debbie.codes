    "@axe-core/playwright": "^4.14.0",
    "@nuxt/content": "^3.16.1",
    "@nuxt/image": "^1.11.0",
    "@nuxtjs/color-mode": "^3.5.2",
    "@nuxtjs/robots": "^5.5.5",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.7.1",
    "endform": "^0.83.2",
    "eslint": "^9.22.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.3",
    "lite-youtube-embed": "^0.3.3",
    "nuxt": "^4.6.0",
    "vitest": "^3.2.7"
